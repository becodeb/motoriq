# ─── POPS backend · variables de entorno ─────────────────────────────────────
# Copiá este archivo a `.env` y ajustá. Ninguna variable es obligatoria para
# desarrollo local: los defaults levantan con SQLite y modo demo.

# Entorno
POPS_DEBUG=true                # logs legibles en consola; false = JSON estructurado
POPS_DEMO_MODE=true            # muestra credenciales seed en /login y devuelve el
                               # token de reset de contraseña en la respuesta (sin SMTP)

# Seguridad — OBLIGATORIO cambiar fuera de desarrollo
POPS_SECRET_KEY=pops-dev-secret-cambiar-en-produccion
POPS_ACCESS_TOKEN_MINUTES=30   # vida del access token (JWT)
POPS_REFRESH_TOKEN_DAYS=14     # vida del refresh token (cookie HttpOnly)

# Base de datos — default: SQLite en backend/pops.db
# PostgreSQL (docker-compose lo configura solo):
# POPS_DATABASE_URL=postgresql+psycopg://pops:pops@localhost:5432/pops
# También se acepta DATABASE_URL sin prefijo.
# POPS_DATABASE_URL=sqlite:///./pops.db

# CORS — orígenes permitidos del frontend (separados por coma)
POPS_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Archivos
POPS_UPLOAD_DIR=uploads        # carpeta de fotos de vehículos
POPS_MAX_UPLOAD_MB=8

# IA — fallback por entorno (la configuración por organización en
# Configuración → IA tiene prioridad). provider: openai | anthropic | gemini | openai_compat
# POPS_AI_PROVIDER=anthropic
# POPS_AI_API_KEY=sk-...
# POPS_AI_MODEL=claude-haiku-4-5-20251001
# POPS_AI_BASE_URL=            # solo para openai_compat (ej: Ollama)

# Procesos internos
POPS_SCHEDULER_ENABLED=true    # tick de 60s: vencimientos, olvidados, insights
POPS_RATE_LIMIT_ENABLED=true   # límite de intentos en /auth y /ai
